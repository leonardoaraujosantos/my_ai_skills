# AminiLLM gateway configuration — copy to your shell profile or a local .env
#
# Never commit a real key. This file holds placeholders only.

# Optional; this is the built-in default.
AMINI_LLM_BASE_URL=http://10.10.20.4:4000/v1

# Required. A LiteLLM virtual key — request one from the gateway owner.
AMINI_LLM_API_KEY=REPLACE_ME
